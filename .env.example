# Copy to .env and fill in (Prisma and Next.js both read it). Never commit real values.
# Supabase > Project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres.<project>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project>:<password>@<pooler-host>:5432/postgres"

# Meta Model API (dev.meta.ai > API keys)
META_API_KEY=""

# Baseten (Muse Spark Open). With only the key set, the defaults below already work.
BASETEN_API_KEY=""

# Any long random string. Vercel Cron sends it to /api/cron/analyst; without it that route answers 401.
CRON_SECRET=""

# The most the paid models (Muse Spark Open on Baseten) may cost per day, in dollars (Madrid calendar day). Default 3.
# Over it the AI inbox and the analyst fall back to the rules engine / report template; 0 switches the models off.
# Sessions need no secret: the cookie holds a random id and the sessions live in the database.
AI_DAILY_BUDGET_USD=3

# Optional overrides (defaults in src/lib/ai/client.ts)
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_MODEL=meta-models/muse-spark-open-1026   (checked 28/10/2026 with GET /v1/models: "[HACKATHON] Muse Spark Open";
#                                                   `meta-models/muse-spark-open` is the same weights without the hackathon tag)
# AGENT_TIMEOUT_MS=25000   total time one message may take with the model before the rules engine answers instead
# META_API_BASE_URL=https://api.llama.com/compat/v1
# META_VISION_MODEL=muse-spark
# META_SAM_URL=https://api.llama.com/v1/sam
# META_SAM_MODEL=sam-3.1
# META_VOICE_MODEL=muse-voice-transcribe

# SAM 3.1 backend on Modal (modal/README.md). Set META_SAM_URL to the Modal URL and SAM_API_KEY to the same value as the Modal secret SAM_TOKEN.
# SAM_API_KEY=""
# META_SAM_URL=https://<workspace>--dockclerk-sam-sam-web.modal.run
