// DockClerk data model.
// The "legacy warehouse software" is a simulated replica built during the hackathon,
// filled with invented data. It is never connected to a real company's database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Master data of the legacy software ----------

/// A building of the 3PL. The rack layout is worked out from these measurements.
model Warehouse {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  city         String
  /// Inside measurements in metres: dock wall to back wall, side to side, clear height.
  length       Float
  width        Float
  height       Float
  /// Set by the forklifts it uses (counterbalance, reach truck, VNA).
  aisleWidth   Float
  docks        Int
  /// Where put-away suggests slots: "customer" (next to the customer's other stock) or "velocity" (fast movers low and near the dock).
  putaway      String            @default("customer")
  stock        Stock[]
  inbounds     Inbound[]
  outbounds    Outbound[]
  appointments DockAppointment[]
  /// Next number for generated pallet codes (N1-000123). Taken with an atomic increment.
  nextPalletNo Int               @default(1)
  createdAt    DateTime          @default(now())
}

enum ClientType {
  RAW_MATERIAL
  FINISHED_GOODS
}

model Client {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  type        ClientType
  /// Person who usually writes in, e.g. "Marta Pérez".
  contact     String?
  email       String?
  phone       String?
  items       Item[]
  stock       Stock[]
  inbounds    Inbound[]
  outbounds   Outbound[]
  messages    Message[]
  /// Portal accounts of this customer.
  users       User[]
  tariff      Tariff?
  handling    Handling[]
  preInvoices PreInvoice[]
}

/// Where outbound goods are delivered (supermarket hubs, factories...).
model Consignee {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  address   String
  city      String
  /// Names customers use in free text, e.g. "Mercadona Riba-roja".
  aliases   String[]
  outbounds Outbound[]
}

model Carrier {
  id           String            @id @default(cuid())
  name         String
  plate        String?
  inbounds     Inbound[]
  outbounds    Outbound[]
  appointments DockAppointment[]
}

enum Unit {
  PALLET
  BOX
  BAG
}

enum PalletType {
  EURO
  AMERICAN
}

model Item {
  id             String         @id @default(cuid())
  clientId       String
  sku            String
  description    String
  unit           Unit
  unitsPerPallet Int
  /// Storage is priced per pallet type (see Tariff).
  palletType     PalletType     @default(EURO)
  tracksLot      Boolean        @default(false)
  client         Client         @relation(fields: [clientId], references: [id])
  stock          Stock[]
  inboundLines   InboundLine[]
  outboundLines  OutboundLine[]

  @@unique([clientId, sku])
}

/// Current balance: goods of a client stored in the warehouse.
/// One row per pallet position: rack slots like "C-07-3" (row-position-level)
/// or floor lanes by the docks like "REC-2" (received, waiting for a slot).
model Stock {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  clientId    String
  itemId      String
  lot         String?
  expiresAt   DateTime?
  /// Physical pallets this row stands for: 1, except the rows of a mixed pallet after the first (the head), which hold 0.
  pallets     Int
  units       Int
  location    String
  /// Picked for this outbound: it sits in a dispatch lane until the truck leaves.
  outboundId  String?
  outbound    Outbound? @relation(fields: [outboundId], references: [id], onDelete: SetNull)
  inboundId   String?
  /// Pallet ID (licence plate), from the supplier label or generated. Rows of a mixed pallet share it,
  /// with the same warehouse, location, client and outboundId. Unique among the pallets inside (checked in code).
  palletCode  String?
  /// Part of its physical pallet, for billing. null = a pallet of its own; the rows of a mixed pallet add up to 1.
  palletShare Float?
  /// Code of the pallet these boxes were taken off (loose pick or one item of a mixed pallet). Replay puts them back.
  splitFrom   String?
  client      Client    @relation(fields: [clientId], references: [id])
  item        Item      @relation(fields: [itemId], references: [id])
  inbound     Inbound?  @relation(fields: [inboundId], references: [id])

  @@index([palletCode])
}

// ---------- Operations ----------

enum InboundStatus {
  EXPECTED
  RECEIVING
  RECEIVED
  CLOSED
}

model Inbound {
  id              String           @id @default(cuid())
  number          Int              @unique @default(autoincrement())
  date            DateTime
  clientId        String
  /// Where it is unloaded.
  warehouseId     String?
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id])
  /// When the goods really came in (set on confirming the receipt). Billing uses receivedAt, or date if it is empty.
  receivedAt      DateTime?
  /// The supplier's delivery note number.
  clientDocRef    String?
  supplier        String?
  carrierId       String?
  plate           String?
  expectedPallets Int?
  expectedUnits   Int?
  receivedPallets Int?
  receivedUnits   Int?
  incident        String?
  status          InboundStatus    @default(EXPECTED)
  /// Secret token for the driver's link (no login, no app). A random UUID v4 (122 bits from the OS random generator):
  /// cuid() is not a secret, it carries a timestamp, a counter and a machine fingerprint.
  driverToken     String           @unique @default(uuid())
  client          Client           @relation(fields: [clientId], references: [id])
  carrier         Carrier?         @relation(fields: [carrierId], references: [id])
  lines           InboundLine[]
  stock           Stock[]
  receipt         DockReceipt?
  appointment     DockAppointment?
  createdAt       DateTime         @default(now())
}

model InboundLine {
  id        String  @id @default(cuid())
  inboundId String
  itemId    String
  lot       String?
  pallets   Int
  units     Int
  inbound   Inbound @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  item      Item    @relation(fields: [itemId], references: [id])
}

enum OutboundStatus {
  REQUESTED
  PREPARED
  SHIPPED
  CLOSED
}

model Outbound {
  id           String           @id @default(cuid())
  number       Int              @unique @default(autoincrement())
  date         DateTime
  deadline     DateTime?
  clientId     String
  /// Set once it is picked; until then the warehouse that can fill it is worked out live.
  warehouseId  String?
  warehouse    Warehouse?       @relation(fields: [warehouseId], references: [id])
  clientDocRef String?
  /// When the truck really left (set on loading it). Billing uses shippedAt, or date if it is empty.
  shippedAt    DateTime?
  consigneeId  String?
  carrierId    String?
  notes        String?
  status       OutboundStatus   @default(REQUESTED)
  client       Client           @relation(fields: [clientId], references: [id])
  consignee    Consignee?       @relation(fields: [consigneeId], references: [id])
  carrier      Carrier?         @relation(fields: [carrierId], references: [id])
  lines        OutboundLine[]
  appointment  DockAppointment?
  picked       Stock[]
  /// What left on the truck, lot by lot, for traceability: [{ itemId, sku, lot, units, location }]
  shipped      Json?
  createdAt    DateTime         @default(now())
}

model OutboundLine {
  id         String   @id @default(cuid())
  outboundId String
  itemId     String
  pallets    Int
  units      Int
  outbound   Outbound @relation(fields: [outboundId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id])
}

enum AppointmentStatus {
  BOOKED
  ARRIVED
  DONE
  NO_SHOW
}

/// A truck's slot at a dock door. Two slots never overlap on the same door.
model DockAppointment {
  id          String            @id @default(cuid())
  warehouseId String
  dock        Int
  startsAt    DateTime
  endsAt      DateTime
  /// Exactly one of them: a truck coming to unload, or one coming to load.
  inboundId   String?           @unique
  outboundId  String?           @unique
  carrierId   String?
  plate       String?
  status      AppointmentStatus @default(BOOKED)
  arrivedAt   DateTime?
  /// "office" or "clerk": who booked it.
  bookedBy    String            @default("office")
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  inbound     Inbound?          @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  outbound    Outbound?         @relation(fields: [outboundId], references: [id], onDelete: Cascade)
  carrier     Carrier?          @relation(fields: [carrierId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([warehouseId, startsAt])
}

/// Proof of delivery at the dock: photos, AI count, damages and driver signature.
model DockReceipt {
  id             String    @id @default(cuid())
  inboundId      String    @unique
  noteImageUrl   String?
  palletImageUrl String?
  /// What the delivery note says vs. what SAM 3.1 counted.
  noteUnits      Int?
  countedUnits   Int?
  /// [{ box: number, note: string }]
  damages        Json?
  /// Lines read from the delivery note: [{ sku, description, lot, pallets, units }]
  noteData       Json?
  /// As received, pallet by pallet: [{ code, generated, lines: [{ itemId, sku, lot, expiresAt, units }] }]
  pallets        Json?
  notePallets    Int?
  countedPallets Int?
  /// Boxes found in the load photo, for the overlay: [{ x, y, w, h, damaged }] in 0..1
  boxes          Json?
  /// Who read the note and who counted: "muse-spark", "sam-3.1", "driver", "operator".
  readBy         String?
  countedBy      String?
  signedBy       String?
  signatureUrl   String?
  pdfUrl         String?
  signedAt       DateTime?
  inbound        Inbound   @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
}

// ---------- Billing: tariffs, handling work and month-end pre-invoices ----------

enum StorageMethod {
  PALLET_DAY
  PALLET_MONTH
  OCCUPANCY
  PER_MOVEMENT
  FIXED
}

/// How a loose pallet (fewer units than fit on a pallet) is charged for storage.
enum PartialPallets {
  /// Units / units per pallet: 12 boxes of a 40-box pallet count as 0.3 pallets.
  FRACTION
  /// Every stock row with goods in it counts as one whole pallet while it is inside.
  FULL
}

/// The prices of one customer (one tariff each, no validity dates). All amounts in euros, VAT excluded.
model Tariff {
  id             String         @id @default(cuid())
  clientId       String         @unique
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  inPerPallet    Float
  outPerPallet   Float
  storageMethod  StorageMethod  @default(PALLET_DAY)
  /// General storage price (per pallet and day). A pallet type without its own price in storageByType uses this one.
  storagePrice   Float
  /// Own prices by pallet type, e.g. {"AMERICAN": 0.18}.
  storageByType  Json           @default("{}")
  handlingPrice  Float          @default(10)
  /// Multiplies every line, in percent.
  factorPct      Float          @default(100)
  vatPct         Float          @default(21)
  partialPallets PartialPallets @default(FRACTION)
}

/// Work on pallets that is charged apart: relabelling, repacking, preparing...
model Handling {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date         DateTime
  pallets      Float
  unitPrice    Float
  /// True when this work is charged instead of the outbound of the same pallets (not twice).
  replacesExit Boolean  @default(true)
  note         String
  /// "office", "clerk" or "floor": who recorded it.
  source       String   @default("office")
  createdAt    DateTime @default(now())

  @@index([clientId, date])
}

enum PreInvoiceStatus {
  DRAFT
  APPROVED
}

/// A frozen month-end statement for one customer. It is NOT an invoice: a person approves it, nothing is sent.
model PreInvoice {
  id             String           @id @default(cuid())
  number         Int              @unique @default(autoincrement())
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// First and last day of the period, both included.
  from           DateTime
  to             DateTime
  status         PreInvoiceStatus @default(DRAFT)
  /// The rule used for loose pallets, frozen with the figures.
  partialPallets PartialPallets   @default(FRACTION)
  lines          Json
  detail         Json
  baseCents      Int
  vatPct         Float
  vatCents       Int
  totalCents     Int
  steps          Json             @default("[]")
  createdAt      DateTime         @default(now())
  approvedAt     DateTime?
  approvedBy     String?

  @@unique([clientId, from, to])
}

// ---------- The AI clerk ----------

enum Channel {
  EMAIL
  WHATSAPP
  PORTAL
  /// Voice notes from the warehouse floor.
  FLOOR
}

enum MessageStatus {
  NEW
  PROCESSING
  PROCESSED
}

model Message {
  id            String        @id @default(cuid())
  channel       Channel
  fromName      String
  fromAddress   String?
  clientId      String?
  subject       String?
  body          String?
  audioUrl      String?
  attachmentUrl String?
  receivedAt    DateTime      @default(now())
  status        MessageStatus @default(NEW)
  client        Client?       @relation(fields: [clientId], references: [id])
  drafts        Draft[]
}

enum DraftKind {
  CREATE_OUTBOUND
  CREATE_INBOUND
  REPLY_ONLY
  NEEDS_HUMAN
}

enum DraftStatus {
  PENDING
  APPROVED
  DISCARDED
}

/// What the agent proposes. Nothing touches the legacy software until a human approves it.
model Draft {
  id        String      @id @default(cuid())
  messageId String?
  kind      DraftKind
  /// Proposed record (outbound/inbound fields).
  payload   Json
  /// Fields the agent is not sure about: [{ field, reason, options }]
  doubts    Json        @default("[]")
  /// Agent trace shown in the UI: [{ step, tool, input, output }]
  steps     Json        @default("[]")
  reply     String?
  status    DraftStatus @default(PENDING)
  message   Message?    @relation(fields: [messageId], references: [id])
  createdAt DateTime    @default(now())
}

/// Photos and audio taken on the floor (delivery notes, loads, signatures, voice notes).
/// Kept in the database so the demo needs no file storage service.
model Upload {
  id        String   @id @default(uuid())
  kind      String
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

/// A report by the analyst agent: the numbers come from code, the story and the priorities from the model.
model AnalystReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// Days of history studied.
  days      Int
  /// "cron" (Monday 07:00) or "office" (Analyze now).
  trigger   String
  /// Who wrote the story: "Muse Spark Open" or "rules".
  brain     String
  headline  String
  summary   String
  /// Findings in priority order, with evidence, method, chart data and action.
  findings  Json
  /// What it could not conclude, and the data it would need.
  gaps      Json     @default("[]")
  /// Trace shown in the console panel.
  steps     Json     @default("[]")
}

// ---------- Accounts, sessions and safety belts ----------

enum UserRole {
  office
  operator
  customer
}

/// A person who can sign in. The demo accounts are created by the seed, which never deletes this table
/// (so the passwords handed to the judges survive a reseed).
model User {
  id           String    @id @default(cuid())
  /// Lower case, what the person types in the login form.
  username     String    @unique
  name         String
  role         UserRole
  /// "scrypt$N$r$p$salt$hash" (see src/lib/auth/password.ts). Never the password.
  passwordHash String
  /// Only for role "customer" (required there, checked in code). The portal reads it from here, never from the browser.
  /// If the customer is deleted the account stays but loses access.
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sessions     Session[]
  createdAt    DateTime  @default(now())

  @@index([clientId])
}

/// A signed-in browser. The cookie holds 32 random bytes; the table keeps only their SHA-256 (id),
/// so a copy of the database cannot be replayed as a cookie.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// What the paid models cost each day (Madrid calendar day), to stop at AI_DAILY_BUDGET_USD.
/// Survives reseeds on purpose. Cost in millionths of a dollar, so sums are exact integers.
model AiSpend {
  day              String   @id
  costMicroUsd     Int      @default(0)
  calls            Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  updatedAt        DateTime @updatedAt
}

/// Fixed-window counters: failed logins per user and address, questions to the portal assistant per user.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}
